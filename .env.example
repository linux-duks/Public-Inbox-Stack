# .env - secrets only (gitignored). Optional: no secrets, no .env needed.
#
# Any leaf value in configs.yaml can be overridden from .env using the
# UPPER_SNAKE_CASE of its dotted path (`.` -> `_`, list indices are numeric):
#
#   imap.inboxes.0.url        -> IMAP_INBOXES_0_URL
#   lei.maildirs.rust.query   -> LEI_MAILDIRS_RUST_QUERY
#   mirroring.0.upstream_host -> MIRRORING_0_UPSTREAM_HOST
#   hosting.http              -> HOSTING_HTTP
#
# Example: keep IMAP credentials out of configs.yaml
# IMAP_INBOXES_0_URL=imaps://user:pass@imap.server.tld:993/INBOX
#
# Other host-level variables used by compose / the controller:
# UID=1000
# GID=1000
# TINYSUPERVISOR_HTTP_PORT=8081
# TINYSUPERVISOR_VERBOSITY=info
# EXTINDEX_DESCRIPTION=All Lore
# ANUBIS_PORT=18888

[publicinbox]
	grokmanifest = all
	wwwListing = all
	css = /dev/null title=default
	css = /static/css/216dark.css \
		title=216dark \
		media='screen,(prefers-color-scheme:dark)'
	css = /static/css/216light.css \
		title=216light \
		media='screen,print,(prefers-color-scheme:light)'

{{#GROKMIRROR_EXTINDEX_ENABLED}}
[extindex "all"]
	topdir = /data/all
	url = https://{{SERVE_HOST}}
{{/GROKMIRROR_EXTINDEX_ENABLED}}

{{#PI_IMAP_ENABLED}}
[publicinbox "{{PI_IMAP_LIST_NAME}}"]
	address = "{{PI_IMAP_LIST_ADDRESS}}"
	obfuscate = true
	url = https://{{SERVE_HOST}}/{{PI_IMAP_LIST_NAME}}
	inboxdir = /data/{{PI_IMAP_LIST_NAME}}
	watch = "{{PI_IMAP_AUTH_URL}}"
	sortorder = 1
{{/PI_IMAP_ENABLED}}

{{#SPAMCHECK_ENABLED}}
[publicinboxwatch]
	spamcheck = spamc
{{/SPAMCHECK_ENABLED}}
